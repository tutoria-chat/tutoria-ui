# Where this repo deploys on Azure (dev): a push to the dev branch.
# Amplify keeps building this repo from git on its own; this only adds the Azure copy.
# Changed by a commit, so the current value is always here to read.
AZURE=true

# Azure ids, printed by tutoria-api/infra/azure/deploy.sh. Identifiers, not secrets.
AZURE_TENANT_ID=6e66b3cc-bd70-42bf-946b-4e5e843df744
AZURE_SUBSCRIPTION_ID=b0954dd4-3c77-4a35-ad46-067714238e11
AZURE_CLIENT_ID=2af2abc4-9b2f-483c-aed3-879b47f24637
AZURE_REGISTRY=tutoriadevtt7q
AZURE_RESOURCE_GROUP=tutoria-dev

# Baked into the bundle at build time (public URLs).
NEXT_PUBLIC_API_BASE_URL=https://tutoria-api-dev.orangeisland-0eb21103.eastus2.azurecontainerapps.io
NEXT_PUBLIC_AI_API_URL=https://tutoria-ai-api-dev.orangeisland-0eb21103.eastus2.azurecontainerapps.io/api/v2
NEXT_PUBLIC_WIDGET_URL=https://kind-bush-069ceb30f.8.azurestaticapps.net
NEXT_PUBLIC_TUTORIALS_ENABLED=true
